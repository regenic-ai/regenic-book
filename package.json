{
  "name": "regenic-book",
  "version": "1.0.0",
  "description": "Regenic book, regenic.ai website, and public methodology. Product: github.com/regenic-ai/regenic.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "audit:prod": "npm audit --omit=dev",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:boundaries": "node scripts/check-content-boundaries.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regenic-ai/regenic-book.git"
  },
  "keywords": [
    "regenic",
    "ai-native",
    "organization-design"
  ],
  "author": "Jeson Li",
  "license": "SEE LICENSE IN LICENSE-CODE",
  "private": false,
  "bugs": {
    "url": "https://github.com/regenic-ai/regenic-book/issues"
  },
  "homepage": "https://github.com/regenic-ai/regenic-book#readme",
  "dependencies": {
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "next": "^16.2.12",
    "postcss": "^8.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.3",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.1",
    "lighthouse": "^13.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
